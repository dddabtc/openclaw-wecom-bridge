{
  "name": "openclaw-wecom-bridge",
  "version": "0.1.0",
  "description": "MVP bridge service between WeCom callbacks and OpenClaw messaging API",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["openclaw", "wecom", "bridge"],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.8.2",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^8.57.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
